{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "jsx": "react-jsx",
    "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true,
    "esModuleInterop": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"]
  },
  "include": ["shared", "server", "web/src", "scripts", "tests"]
}
